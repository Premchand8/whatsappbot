# simulate = local chat UI, no Meta required
# live     = real WhatsApp Cloud API
WHATSAPP_MODE=simulate

PORT=3000
# Optional: defaults to the Netlify site URL when deployed
PUBLIC_BASE_URL=http://localhost:3000

# Data is stored in Netlify Database (managed Postgres) — no connection string needed.

# --- Required only when WHATSAPP_MODE=live ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=readylocal_verify
WHATSAPP_APP_SECRET=

# --- Approved template names (paste after Meta approval) ---
TEMPLATE_BOOKING_UPDATE=booking_update
TEMPLATE_ASSIGNMENT=professional_assigned
TEMPLATE_START_OTP=start_otp
TEMPLATE_COMPLETION_OTP=completion_otp
TEMPLATE_LANGUAGE=en
